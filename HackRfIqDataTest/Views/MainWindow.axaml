<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HackRfIqDataTest.ViewModels"
        xmlns:models="using:HackRfIqDataTest.Models"
        xmlns:views="using:HackRfIqDataTest.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="950"
        Width="1100" Height="950"
        x:Class="HackRfIqDataTest.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="HackRfIqDataTest">

    <TabControl>
        <TabItem Header="Capture">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="420"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
        
                <StackPanel Grid.Column="0" Margin="15,15,0,0" Spacing="10">
                    <StackPanel.Styles>
                        <Style Selector="StackPanel.field > TextBlock">
                            <Setter Property="Width" Value="170"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </StackPanel.Styles>

                    <StackPanel Classes="field" Orientation="Horizontal">
                        <TextBlock Text="Start Frequency MHz"/>
                        <TextBox Text="{Binding StartFrequency}" Width="180"/>
                    </StackPanel>
        
                    <StackPanel Classes="field" Orientation="Horizontal">
                        <TextBlock Text="End Frequency MHz"/>
                        <TextBox Text="{Binding EndFrequency}" Width="180"/>
                    </StackPanel>

                    <TextBlock Text="Single capture" FontWeight="SemiBold" Margin="0,10,0,0"/>
        
                    <StackPanel Classes="field" Orientation="Horizontal">
                        <TextBlock Text="Capture Duration ms"/>
                        <TextBox Text="{Binding CaptureDurationMs}" Width="180"/>
                    </StackPanel>
        
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Height="35" Content="capture data" VerticalContentAlignment="Center" 
                                Command="{Binding CaptureData}"/>
                        <Button Height="35" Content="save to file" VerticalContentAlignment="Center" 
                                Command="{Binding SaveCapture}"/>
                    </StackPanel>

                    <TextBlock Text="Continuous recording" FontWeight="SemiBold" Margin="0,10,0,0"/>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Height="35" Content="start recording" VerticalContentAlignment="Center" 
                                Command="{Binding StartRecording}"/>
                        <Button Height="35" Content="stop recording" VerticalContentAlignment="Center" 
                                Command="{Binding StopRecording}"/>
                    </StackPanel>

                    <TextBlock Text="{Binding RecordingStatus}"/>
                </StackPanel>
        
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
            
                    <Button Grid.Row="1" Content="Clear" HorizontalAlignment="Right" 
                            Command="{Binding ClearLog}" Margin="0,0,35,0"/>
            
                    <ListBox Grid.Row="3" ItemsSource="{Binding UserLog.Log}" Margin="0,0,10,0"/>
                </Grid>
        
                <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="15,0,10,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
            
                    <TextBlock Grid.Row="0" Text="{Binding CaptureDetails}"/>
            
                    <DataGrid Grid.Row="2" ItemsSource="{Binding Samples}" IsReadOnly="True"
                              AutoGenerateColumns="False" GridLinesVisibility="All" BorderThickness="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Index" Binding="{Binding Index}" x:DataType="models:IqSample" Width="120"/>
                            <DataGridTextColumn Header="I" Binding="{Binding I}" x:DataType="models:IqSample" Width="100"/>
                            <DataGridTextColumn Header="Q" Binding="{Binding Q}" x:DataType="models:IqSample" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>
        </TabItem>
        
        <TabItem Header="Analysis">
            <views:AnalysisView DataContext="{Binding Analysis}"/>
        </TabItem>
    </TabControl>
</Window>
